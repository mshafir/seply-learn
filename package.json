{
  "name": "umbel-learn",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check:deps": "node scripts/check-deps.mjs",
    "check": "pnpm check:deps && VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-2} turbo typecheck lint test --concurrency=${TURBO_CONCURRENCY:-2}",
    "check:private": "node scripts/check-private.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.9.18",
    "typescript": "~6"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
