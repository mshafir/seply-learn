# Seply Learn, self-hosted: settings for docker-compose.yml.
#
#   cp .env.example .env
#
# then fill in the three REQUIRED values below and one AI key. Everything else
# is optional: a commented line shows its default. docs/self-host.md explains
# each part; apps/server-node/README.md is the reference for every variable.
# Restart after a change: docker compose up -d

# ============================================================================
# REQUIRED
# ============================================================================

# The address people type to reach this instance: sign-in callbacks, invite
# links and MCP use it. Behind a proxy with TLS: https://learn.example.com
BETTER_AUTH_URL=http://localhost:3000

# Signs sessions and MCP keys. At least 32 characters; keep it stable
# (changing it signs everyone out). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The bundled Postgres's password. Letters and digits only (it goes into a
# URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# ============================================================================
# Compose
# ============================================================================

# The image: built from this checkout by default. To run a release instead:
#   SEPLY_IMAGE=ghcr.io/mshafir/seply-learn:v1.0.0   (then: docker compose pull app)
# SEPLY_IMAGE=seply-learn:local
# The host port the app is published on (match it in BETTER_AUTH_URL).
# SEPLY_PORT=3000
# A host folder mounted at /data/tiles (read-only) for a PMTiles extract.
# SEPLY_TILES_DIR=./tiles
# Optional services: s3 starts MinIO (see "Source files" below).
# COMPOSE_PROFILES=s3
# POSTGRES_USER=seply
# POSTGRES_DB=seply

# ============================================================================
# AI: who pays for the models
# ============================================================================

# instance: your key serves everyone (set one key below).
# byok: each reader adds their own key in Settings (set AI_KEYS_MASTER_KEY).
# AI_KEY_MODE=instance

# The instance key: set ONE of these (the first one found wins, in this order).
# A Vercel AI Gateway key (every provider through one key):
# AI_GATEWAY_API_KEY=
# Or a provider's own key:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Or an OpenAI-compatible server (Ollama, LM Studio, vLLM…), e.g. Ollama on
# the host: http://host.docker.internal:11434/v1 (the key may be any text).
# It has no default models: set AI_MODEL_SKIM, _CURATOR and _WRITER too.
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# Instance mode: the model per stage, over the provider's defaults (required
# for an OpenAI-compatible server).
# AI_MODEL_SKIM=
# AI_MODEL_CURATOR=
# AI_MODEL_WRITER=

# byok: 32 random bytes, base64. Readers' keys are encrypted under it; changing
# or losing it makes them unreadable. Generate: openssl rand -base64 32
# AI_KEYS_MASTER_KEY=

# ============================================================================
# Sign-in
# ============================================================================

# Email + password (on by default). 0 with Google configured: Google only.
# AUTH_EMAIL_PASSWORD=1
# 0 closes sign-up once your accounts exist; they still sign in.
# AUTH_EMAIL_SIGNUP=1
# Google sign-in. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Extra trusted origins, comma-separated.
# AUTH_TRUSTED_ORIGINS=

# ============================================================================
# Email (invites). Without SMTP or Resend, invites are only logged; the
# invite link and the in-app inbox still work.
# ============================================================================

# SMTP_HOST=smtp.example.com
# 465 with SMTP_SECURE=1.
# SMTP_PORT=587
# 1: TLS from the start; else STARTTLS when offered.
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# Required with SMTP:
# EMAIL_FROM="Seply Learn <learn@example.com>"
# Or Resend instead of SMTP:
# RESEND_API_KEY=

# ============================================================================
# Source files (uploads and their segments)
# ============================================================================

# By default they go to the `data` volume (/data/blobs). For S3 or any
# S3-compatible store, set S3_BUCKET and its keys (S3_BUCKET switches the
# store to s3). With the bundled MinIO, uncomment COMPOSE_PROFILES=s3 above
# and these five; compose creates the bucket. The secret: 8+ characters,
# e.g. openssl rand -hex 24.
# S3_BUCKET=seply
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY_ID=seply
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# Path-style URLs (<endpoint>/<bucket>/<key>, MinIO). 0: <bucket>.<endpoint host>.
# S3_FORCE_PATH_STYLE=1
# fs or s3. Default: s3 when S3_BUCKET is set, else fs.
# BLOB_STORE=

# ============================================================================
# The Map View's basemap (docs/self-host.md: "Map tiles")
# ============================================================================

# Unset: OpenFreeMap's public styles. With an extract in SEPLY_TILES_DIR:
# MAP_TILES_FILE=/data/tiles/basemap.pmtiles
# Or a .pmtiles served elsewhere (it must allow Range requests and CORS):
# MAP_TILES_URL=https://tiles.example.com/basemap.pmtiles
# A copy of Protomaps' fonts and sprites (default: protomaps.github.io):
# MAP_ASSETS_URL=

# ============================================================================
# Web push for finished builds (off without the keys).
# Generate a pair: npx web-push generate-vapid-keys
# ============================================================================

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ============================================================================
# Tuning (defaults are fine for most instances)
# ============================================================================

# DATABASE_POOL_MAX=10
# Builds one instance runs at once.
# JOBS_CONCURRENCY=4
# JOBS_HEARTBEAT_SECONDS=30
# UTC, 5 fields; off to never purge.
# TRASH_PURGE_CRON="17 4 * * *"
# SHUTDOWN_GRACE_SECONDS=25
# 0 when you run `migrate` yourself.
# MIGRATE_ON_START=1
# A label /api/health reports.
# DB_BRANCH=

# Set by the image or by docker-compose.yml; change only if you know why:
# PORT, HOST, WEB_DIST, MIGRATIONS_DIR, BLOB_DIR, and DATABASE_URL (compose
# builds it from POSTGRES_*). AUTH_TEST_CREDENTIALS is for tests only.
