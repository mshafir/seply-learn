// The seply-site Worker: static assets, plus a small script for /media/* only
// (worker/index.ts: HTTP Range requests for the video, which static assets
// don't answer). Every other path is served by static assets directly.
// CI deploys it (docs/ops/deploy.md): production as seply-site with the
// seply.app custom domain (--domain), each PR preview as seply-site-pr-<n>.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seply-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Build it first: `pnpm --filter @seply/site build`.
    "directory": "./dist",
    "binding": "ASSETS",
    // Only media goes through the script; everything else is plain assets.
    "run_worker_first": ["/media/*"],
    // /self-host serves self-host/index.html (redirecting to /self-host/).
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
  },
  // Keep the workers.dev URL working next to the custom domain.
  "workers_dev": true,
  "preview_urls": false,
}
