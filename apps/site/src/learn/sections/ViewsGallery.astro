---
// The Views gallery: five View Types as tabs (src/scripts/tabs.ts, the WAI
// tabs pattern with automatic activation), then the other six named. Without
// JavaScript the first panel shows.
import MediaImage from "../../components/MediaImage.astro"
import { container, eyebrow, h2, monoLabel, textLink } from "../../lib/styles"
import { GALLERY, MORE_VIEWS } from "../content"
---

<section id="views" class="scroll-mt-20 border-t border-border bg-card">
  <div class:list={[container, "flex flex-col gap-8 py-20"]}>
    <div class="flex max-w-[40em] flex-col gap-3">
      <span class={eyebrow}>Views</span>
      <h2 class={h2}>You can read the same Expedition in several ways</h2>
      <p class="m-0 text-muted-foreground">
        Each View is built to answer a particular question about the Concepts. When you have a new question, you can ask
        for a new View.
      </p>
    </div>
    <div data-tabs class="flex flex-col gap-8">
      <div role="tablist" aria-label="View Types" class="flex flex-wrap gap-2">
        {
          GALLERY.map((v, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${v.id}`}
              aria-controls={`panel-${v.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="inline-flex min-h-10 cursor-pointer items-center rounded-full border border-border bg-background px-4 text-sm text-foreground aria-selected:border-foreground aria-selected:bg-foreground aria-selected:font-medium aria-selected:text-background"
            >
              {v.label}
            </button>
          ))
        }
      </div>
      {
        GALLERY.map((v, i) => (
          <div
            role="tabpanel"
            id={`panel-${v.id}`}
            aria-labelledby={`tab-${v.id}`}
            hidden={i !== 0}
            class="grid grid-cols-1 items-start gap-8 lg:grid-cols-3"
          >
            <MediaImage
              slot={v.shot}
              class="aspect-[16/10] min-w-0 rounded-xl border border-border bg-background lg:col-span-2"
              labelClass="text-xs p-6"
            />
            <div class="flex flex-col gap-3.5">
              <span class={monoLabel}>{v.kicker}</span>
              <p class="m-0 font-reading text-2xl leading-[1.3]">{v.question}</p>
              <a href={v.href} class={textLink}>
                Open this View
              </a>
            </div>
          </div>
        ))
      }
    </div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 rounded-[10px] border border-dashed border-border px-5 py-4 text-sm text-muted-foreground">
      <span class="font-semibold text-foreground">+ {MORE_VIEWS.length} more Views</span>
      <span>{MORE_VIEWS.join(" · ")}</span>
    </div>
  </div>
</section>

<script>
  import "../../scripts/tabs"
</script>
