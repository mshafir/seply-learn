---
// The closing band, on the brand's sprout green.
import { cn } from "@seply/ui/lib/utils"

import { APP_URL } from "../../lib/env"
import { container, link, primaryButton } from "../../lib/styles"
---

<section class="bg-sprout">
  <div class:list={[container, "flex flex-col items-center gap-5 py-[88px] text-center"]}>
    <h2 class="m-0 font-reading text-[clamp(32px,4vw,44px)] leading-[1.1] font-medium text-calyx [font-variation-settings:'opsz'_72]">
      Start with a question.
    </h2>
    <p class="m-0 max-w-[36em] text-foreground">
      Sign in with Google to create an account. Then connect the AI agent you already use, or add your own API key, and
      ask your first question. You can read public Expeditions, and anything shared with you, straight away. If you'd
      rather run it on your own machine, you can <a href="/self-host/" class:list={[link, "font-medium"]}>self-host</a> it.
    </p>
    <a href={APP_URL} class={cn(primaryButton, "px-6")}>Sign in</a>
  </div>
</section>
