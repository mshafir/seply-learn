---
// The Learn landing page (spec 9.2), ported from the approved mockup.
// Mounted at / by src/pages/index.astro (see README.md, "Routes").
import Base from "../layouts/Base.astro"
import SiteFooter from "../components/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader.astro"
import { DESCRIPTION } from "./copy"
import Agents from "./sections/Agents.astro"
import Closing from "./sections/Closing.astro"
import Examples from "./sections/Examples.astro"
import Hero from "./sections/Hero.astro"
import HowItWorks from "./sections/HowItWorks.astro"
import ReadTogether from "./sections/ReadTogether.astro"
import SelfHost from "./sections/SelfHost.astro"
import VideoSection from "./sections/Video.astro"
import ViewsGallery from "./sections/ViewsGallery.astro"
---

<Base description={DESCRIPTION}>
  <SiteHeader />
  <main id="top" class="scroll-mt-20">
    <Hero />
    <HowItWorks />
    <VideoSection />
    <ViewsGallery />
    <Agents />
    <ReadTogether />
    <Examples />
    <SelfHost />
    <Closing />
  </main>
  <SiteFooter />
</Base>
