---
// /self-host: docs/self-host.md rendered at build time (the repo stays its one
// source), with a table of contents from its sections and copy buttons on its
// code blocks. Relative links become GitHub links (src/lib/rehype-repo-docs.ts).
// Mounted at /self-host/ by src/pages/self-host.astro.
import { getEntry, render } from "astro:content"

import Base from "../layouts/Base.astro"
import SiteFooter from "../components/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader.astro"
import { container } from "../lib/styles"
import { GITHUB_BLOB } from "../lib/rehype-repo-docs"

const entry = await getEntry("docs", "self-host")
if (!entry) throw new Error("docs/self-host.md is missing")
const { Content, headings } = await render(entry)
const title = headings.find((h) => h.depth === 1)?.text ?? "Self-hosting Seply Learn"
const sections = headings.filter((h) => h.depth === 2)
---

<Base
  title="Self-hosting"
  description="Run Seply Learn on your own machine or server: one container plus Postgres, with Docker Compose and your own AI key."
>
  <SiteHeader />
  <div class:list={[container, "grid grid-cols-1 gap-12 pt-14 pb-24 lg:grid-cols-[220px_minmax(0,1fr)]"]}>
    <aside class="hidden lg:block">
      <nav aria-label="On this page" class="sticky top-24 flex flex-col gap-2 text-sm">
        <span class="font-mono text-xs font-medium tracking-[0.06em] text-muted-foreground uppercase">On this page</span>
        <ol class="m-0 flex list-none flex-col gap-1.5 p-0">
          {
            sections.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="rounded-sm text-muted-foreground hover:text-foreground">
                  {h.text}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </aside>
    <main id="top" class="min-w-0">
      <article class="typeset max-w-[46rem]" aria-label={title}>
        <Content />
      </article>
      <p class="mt-12 text-sm text-muted-foreground">
        This page is built from <a
          class="text-primary underline underline-offset-4 hover:no-underline"
          href={`${GITHUB_BLOB}docs/self-host.md`}>docs/self-host.md</a
        > in the repository.
      </p>
    </main>
  </div>
  <SiteFooter />
</Base>

<style is:global>
  /* Code blocks on the ink colour, like the landing page's snippets. */
  .typeset pre {
    background: var(--foreground);
    color: var(--background);
    border: 0;
    border-radius: 0.75rem;
    font-size: 13px;
    line-height: 1.7;
  }
  /* Long lines and wide tables scroll inside themselves, never the page. */
  .typeset pre {
    overflow-x: auto;
    max-width: 100%;
  }
  .typeset table {
    display: block;
    overflow-x: auto;
    max-width: 100%;
  }
  .typeset .copy-wrap > pre {
    padding-right: 5.5rem;
  }
  .typeset h1 {
    font-size: clamp(32px, 4vw, 44px);
    line-height: 1.1;
    font-weight: 500;
    font-variation-settings: "opsz" 72;
  }
  .typeset h2 {
    font-weight: 500;
    font-variation-settings: "opsz" 72;
  }
  .typeset pre code {
    color: inherit;
    background: none;
  }
</style>
