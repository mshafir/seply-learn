// Cloudflare Worker config. See docs/ops/deploy.md for how CI deploys it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seply-learn",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // pg needs Node APIs (net, tls, crypto). On by default from 2026-08-04; kept explicit.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    // Build it first: `pnpm --filter web build`.
    "directory": "../web/dist",
    "binding": "ASSETS",
    // Unknown paths get index.html so client-side routes work.
    "not_found_handling": "single-page-application",
    // The API, MCP (WP-5.4) and OAuth discovery run before the SPA fallback.
    "run_worker_first": ["/api/*", "/mcp", "/.well-known/*"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder. CI writes the real id per deploy (scripts/deploy-config.mjs):
      // one Hyperdrive config per PR preview, one for production.
      // Local dev: set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
      "id": "00000000000000000000000000000000",
    },
  ],
  // The Expedition room (spec §2.4): one Durable Object per Expedition.
  "durable_objects": {
    "bindings": [{ "name": "EXPEDITION_ROOM", "class_name": "ExpeditionRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ExpeditionRoom"] }],
  // Jobs (spec §2.5): one Workflow runs every job kind. Workflow names are
  // unique per account; CI renames it per Worker (scripts/ci.mjs).
  "workflows": [
    {
      "name": "seply-learn-jobs",
      "binding": "JOBS",
      "class_name": "JobWorkflow",
    },
  ],
  // Source files and their segments (spec §2.7). CI points previews at
  // seply-sources-preview (scripts/ci.mjs r2-bucket); wrangler dev simulates it locally.
  "r2_buckets": [{ "binding": "SOURCES", "bucket_name": "seply-sources" }],
  // Daily: purge Expeditions whose 30 days in Trash are over (WP-5.2).
  // Previews drop it (scripts/ci.mjs hyperdrive-upsert).
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": {
    // The Neon branch this deploy reads from; CI overrides it with --var.
    "DB_BRANCH": "local",
  },
}
