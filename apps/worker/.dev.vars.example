# Local dev settings for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# See docs/ops/deploy.md, "Running it locally".

# This server's own origin: http://localhost:8787 for `wrangler dev`, or
# http://localhost:5173 when you browse through the Vite dev server.
BETTER_AUTH_URL=http://localhost:8787
# Any random string, e.g. `openssl rand -base64 32`. Local only.
BETTER_AUTH_SECRET=
# The Google OAuth client (localhost:8787 and :5173 are registered with it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "1" enables email + password sign-in for tests. Ignored on non-localhost URLs.
AUTH_TEST_CREDENTIALS=

# --- AI (spec §5.6; packages/server README, "AI") ---
# Key mode: "instance" (default; the key below serves everyone) or "byok"
# (each reader adds their own key in Settings).
AI_KEY_MODE=
# Instance key: a Vercel AI Gateway key (the hosted instance uses one).
# Self-host alternatives, used when it's unset: ANTHROPIC_API_KEY,
# OPENAI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, or OPENAI_COMPATIBLE_BASE_URL
# (+ OPENAI_COMPATIBLE_API_KEY and AI_MODEL_SKIM/CURATOR/WRITER).
AI_GATEWAY_API_KEY=
# BYOK mode: the master key readers' keys are encrypted under. 32 random
# bytes, base64: `openssl rand -base64 32`. Changing it makes stored keys
# unreadable (readers add them again).
AI_KEYS_MASTER_KEY=
# "1": wake running jobs after a restart (wrangler dev doesn't resume Workflows).
JOBS_WAKE_ON_START=1
# Web push (optional): a VAPID key pair, base64url. Off when empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
