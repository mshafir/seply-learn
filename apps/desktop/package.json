{
  "name": "desktop",
  "productName": "Seply Learn",
  "version": "0.1.0",
  "description": "The Seply Learn desktop app: a shell around a server's web client.",
  "type": "module",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs && vite build",
    "dev": "node scripts/ensure-electron.mjs && pnpm build && electron .",
    "start": "node scripts/ensure-electron.mjs && electron .",
    "test:e2e": "node scripts/ensure-electron.mjs && pnpm build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@seply/ui": "workspace:*",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.63.0",
    "@seply/config": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17",
    "tailwindcss": "^4",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4"
  }
}
